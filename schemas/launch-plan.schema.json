{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexus.cli/schemas/launch-plan.schema.json",
  "title": "Nexus launch plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "adapter", "chainId", "account", "deployment", "preparedAt", "request", "snapshot", "transaction", "expected", "summary", "warnings", "id"],
  "properties": {
    "schemaVersion": { "const": "1" },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "enum": ["flap-standard", "pons-v2"] },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "chainId": { "enum": [56, 4663] },
    "account": { "$ref": "#/$defs/address" },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["address", "protocolVersion", "runtimeCodeHash"],
      "properties": {
        "address": { "$ref": "#/$defs/address" },
        "protocolVersion": { "type": "string", "minLength": 1 },
        "runtimeCodeHash": { "$ref": "#/$defs/hash" },
        "implementation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["address", "runtimeCodeHash"],
          "properties": {
            "address": { "$ref": "#/$defs/address" },
            "runtimeCodeHash": { "$ref": "#/$defs/hash" }
          }
        }
      }
    },
    "preparedAt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blockHash", "blockNumber"],
      "properties": {
        "blockHash": { "$ref": "#/$defs/hash" },
        "blockNumber": { "$ref": "#/$defs/decimal" }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["token", "launch"],
      "properties": {
        "token": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "symbol", "description", "image", "socials"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "symbol": { "type": "string", "minLength": 1 },
            "description": { "type": "string" },
            "image": { "type": "string" },
            "socials": {
              "type": "object",
              "additionalProperties": false,
              "required": ["discord", "farcaster", "telegram", "twitter", "website"],
              "properties": {
                "discord": { "type": "string" },
                "farcaster": { "type": "string" },
                "telegram": { "type": "string" },
                "twitter": { "type": "string" },
                "website": { "type": "string" }
              }
            }
          }
        },
        "launch": { "$ref": "#/$defs/jsonObject" }
      }
    },
    "snapshot": { "$ref": "#/$defs/jsonObject" },
    "transaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["to", "data", "value"],
      "properties": {
        "to": { "$ref": "#/$defs/address" },
        "data": { "type": "string", "pattern": "^0x(?:[0-9a-fA-F]{2})*$" },
        "value": { "$ref": "#/$defs/decimal" }
      }
    },
    "expected": { "$ref": "#/$defs/jsonObject" },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "pricing", "liquidity", "costs", "rows"],
      "properties": {
        "protocol": { "type": "string" },
        "pricing": { "type": "string" },
        "liquidity": { "type": "string" },
        "costs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "asset", "amount"],
            "properties": {
              "label": { "type": "string" },
              "asset": { "type": "string" },
              "amount": { "$ref": "#/$defs/decimal" }
            }
          }
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "value"],
            "properties": {
              "label": { "type": "string" },
              "value": { "type": "string" }
            }
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message"],
        "properties": {
          "code": { "type": "string", "minLength": 1 },
          "message": { "type": "string", "minLength": 1 }
        }
      }
    },
    "id": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "address": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "decimal": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" },
    "hash": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" },
    "jsonObject": { "type": "object", "additionalProperties": { "$ref": "#/$defs/jsonValue" } },
    "jsonValue": {
      "anyOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "number" },
        { "type": "string" },
        { "type": "array", "items": { "$ref": "#/$defs/jsonValue" } },
        { "$ref": "#/$defs/jsonObject" }
      ]
    }
  }
}
